# Variables of docker-compose.yaml. Each one has a development default.

# POSTGRES_PASSWORD=password
# MAROID_DB_PASSWORD=password
# DEX_DB_PASSWORD=password
# DEX_HUB_CLIENT_SECRET=ZXhhbXBsZS1hcHAtc2VjcmV0
# RUSTFS_ACCESS_KEY=rustfsadmin
# RUSTFS_SECRET_KEY=rustfsadmin
# MAROID_FILES_ACCESS_KEY=maroid-hub
# MAROID_FILES_SECRET_KEY=maroid-hub-secret

# The static seal key of OpenBao. Generate one with: openssl rand -hex 32
OPENBAO_SEAL_KEY=

# The profile "tunnel" starts ngrok, which forwards NGROK_DOMAIN to the hub.
# COMPOSE_PROFILES=tunnel
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
