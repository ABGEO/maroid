{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		"schedule:weekly",
		":semanticCommits",
		":semanticCommitTypeAll(chore)",
		":semanticCommitScope(deps)",
		"docker:pinDigests",
		"security:minimumReleaseAgeNpm",
		"group:allNonMajor"
	],
	"commitMessageTopic": "{{depName}}",
	"osvVulnerabilityAlerts": true,
	"postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths", "pnpmDedupe"],
	"packageRules": [
		{
			"description": "A plugin loads only when it shares every package version with the hub, the indirect ones included.",
			"matchDepTypes": ["indirect"],
			"enabled": true
		},
		{
			"description": "An indirect major is a new module path that only a direct dependency can adopt.",
			"matchDepTypes": ["indirect"],
			"matchUpdateTypes": ["major"],
			"enabled": false
		},
		{
			"description": "A digest update moves with the other non-major updates. The rules below take the Go pseudo-versions into their own groups.",
			"matchUpdateTypes": ["digest"],
			"groupName": "all non-major dependencies",
			"groupSlug": "all-minor-patch"
		},
		{
			"description": "The non-major updates of the Go modules move in their own pull request.",
			"matchManagers": ["gomod"],
			"matchDepTypes": ["require", "indirect"],
			"matchUpdateTypes": ["minor", "patch", "digest"],
			"groupName": "go modules",
			"groupSlug": "go-modules"
		},
		{
			"description": "The non-major updates of the npm packages move in their own pull request.",
			"matchManagers": ["npm"],
			"matchDepTypes": [
				"dependencies",
				"devDependencies",
				"peerDependencies",
				"optionalDependencies"
			],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "npm packages",
			"groupSlug": "npm-packages"
		},
		{
			"description": "The maroid libraries move in their own pull request, apart from the third party updates.",
			"matchPackageNames": ["github.com/abgeo/maroid/**"],
			"groupName": "maroid libraries",
			"groupSlug": "maroid-libraries"
		},
		{
			"description": "The non-major updates of the Dockerfile base images move in their own pull request.",
			"matchManagers": ["dockerfile"],
			"matchUpdateTypes": ["minor", "patch", "digest"],
			"groupName": "dockerfile base images",
			"groupSlug": "dockerfile-base-images"
		},
		{
			"description": "The Go, Node, and pnpm versions of the Dockerfiles pick the golang and node base images, and the go.mod and package.json files follow them in the same pull request.",
			"matchDepNames": ["go", "node", "pnpm"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "dockerfile base images",
			"groupSlug": "dockerfile-base-images"
		},
		{
			"description": "The go directive of every go.mod follows the Go version of the Dockerfiles.",
			"matchDepNames": ["go"],
			"rangeStrategy": "bump"
		},
		{
			"description": "The FROM line builds these tags from ARGs that the custom managers update.",
			"matchManagers": ["dockerfile"],
			"matchPackageNames": ["golang", "node", "ghcr.io/abgeo/**"],
			"enabled": false
		},
		{
			"description": "The development images of docker-compose.yaml move in their own pull request, by tag and without a digest pin.",
			"matchManagers": ["docker-compose"],
			"pinDigests": false,
			"groupName": "docker compose images",
			"groupSlug": "docker-compose-images"
		}
	],
	"customManagers": [
		{
			"customType": "regex",
			"description": "The Go version of the Dockerfiles.",
			"managerFilePatterns": ["/(^|/)Dockerfile$/"],
			"matchStrings": ["ARG GO_VERSION=(?<currentValue>\\S+)"],
			"datasourceTemplate": "golang-version",
			"depNameTemplate": "go"
		},
		{
			"customType": "regex",
			"description": "The Node version of the Dockerfiles.",
			"managerFilePatterns": ["/(^|/)Dockerfile$/"],
			"matchStrings": ["ARG NODE_VERSION=(?<currentValue>\\S+)"],
			"datasourceTemplate": "node-version",
			"depNameTemplate": "node"
		},
		{
			"customType": "regex",
			"description": "The pnpm version of the Dockerfiles.",
			"managerFilePatterns": ["/(^|/)Dockerfile$/"],
			"matchStrings": ["ARG PNPM_VERSION=(?<currentValue>\\S+)"],
			"datasourceTemplate": "npm",
			"depNameTemplate": "pnpm"
		}
	]
}
